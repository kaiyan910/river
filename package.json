{
  "name": "river",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "seed:admin": "bun run --cwd apps/api seed:admin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3"
  }
}
