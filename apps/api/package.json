{
  "name": "@river/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --conditions=source --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "replay:record": "RECORD_REPLAY_HISTORIES=1 vitest run test/record-replay-histories.test.ts",
    "seed:admin": "node --env-file-if-exists=../../.env --conditions=source --import @swc-node/register/esm-register src/scripts/seed-admin.ts",
    "setup:storage": "node --env-file-if-exists=../../.env --conditions=source --import @swc-node/register/esm-register src/scripts/setup-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@river/auth": "workspace:*",
    "@river/contracts": "workspace:*",
    "@river/db": "workspace:*",
    "@river/dsl": "workspace:*",
    "@river/email": "workspace:*",
    "@river/forms": "workspace:*",
    "@river/logger": "workspace:*",
    "@temporalio/client": "^1.24.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@river/config": "workspace:*",
    "@river/worker": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@temporalio/common": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "testcontainers": "^12.1.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
