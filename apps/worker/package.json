{
  "name": "@river/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./workflows": {
      "source": "./src/workflows/index.ts",
      "types": "./src/workflows/index.ts",
      "default": "./dist/workflows/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@river/contracts": "workspace:*",
    "@river/db": "workspace:*",
    "@river/dsl": "workspace:*",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@river/config": "workspace:*",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
