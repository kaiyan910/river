# 複製成 repo 根目錄的 .env；api、worker、db:migrate、seed:admin 都會讀取它。
DATABASE_URL=postgres://river:river@localhost:5432/river
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=river

# api
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
# 瀏覽器看到的網址：Vite dev server 為 http://localhost:5173，經過 Caddy 為 http://localhost:8000
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
PORT=3000

# seed:admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=change-me-please

# Email：本機與 CI 用 smtp 寄到 Mailpit（http://localhost:8025），production 用 resend
EMAIL_TRANSPORT=smtp
EMAIL_FROM=River <no-reply@river.localhost>
SMTP_URL=smtp://localhost:1025
# EMAIL_TRANSPORT=resend 時必填
# RESEND_API_KEY=
